    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "vitest": "^5.0.1"
  }
}