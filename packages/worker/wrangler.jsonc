{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "papra-sidecar-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}